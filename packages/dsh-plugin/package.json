{
  "name": "@1agents/dsh-acp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "External ACP Agent sessions for DeepSeek Harness",
  "exports": {
    ".": "./dist/index.js",
    "./preset": "./dist/preset.js",
    "./package.json": "./package.json",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-client.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottzx/1acp.git",
    "directory": "packages/dsh-plugin"
  }
}
