{
  "name": "@1agents/acp-service",
  "version": "0.3.0",
  "description": "DreamMate Network ACP Agent Runtime Service: cross-agent execution runtime for Claude Code, Grok, Codex and ACP-compatible agents.",
  "keywords": [
    "dreammate",
    "acp",
    "agent-runtime",
    "claude-code",
    "grok",
    "codex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottzx/1acp.git",
    "directory": "packages/service"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "acp-service": "dist/bin/acp-service.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "prepack": "npm run build",
    "start": "tsx bin/acp-service.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@1agents/dreammate-network": "^0.3.1",
    "@1agents/dreammate-node": "^0.4.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "@scottzx/1acp": "workspace:^",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
